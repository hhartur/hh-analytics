{
  "name": "@hh./analytics",
  "version": "0.1.1",
  "description": "SDK leve de analytics para a sua própria instalação do hh-analytics (self-hosted, sem cookies, sem servidor central)",
  "license": "MIT",
  "author": "hhartur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhartur/hh-analytics.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/hhartur/hh-analytics/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/hhartur/hh-analytics/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./script": "./dist/hh-analytics.min.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/hh-analytics.min.js",
  "jsdelivr": "./dist/hh-analytics.min.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "analytics",
    "self-hosted",
    "privacy",
    "pageview",
    "events",
    "lgpd",
    "gdpr",
    "sdk"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/sdk.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
