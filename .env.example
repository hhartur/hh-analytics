# Copie para .env e troque as senhas: cp .env.example .env

# Banco (PostgreSQL no próprio docker compose)
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=troque-esta-senha

# Porta onde a API e o painel ficam (http://localhost:4000)
PORT=4000

# Atrás de proxy reverso (Caddy, Nginx, Cloudflare): número de proxies na frente, para os limites verem o IP real
TRUST_PROXY=

# Só o primeiro usuário se cadastra sozinho (vira dono). true abre o cadastro para qualquer pessoa.
ALLOW_REGISTER=false

# Apaga visitas e eventos com mais de N dias, uma vez por dia (0 = guarda tudo)
RETENTION_DAYS=0

# Painel: on (padrão) ou off (só a API). Para usar um painel próprio, monte a pasta dele no container e aponte aqui
# (veja "Painel próprio" no README). Ex.: DASHBOARD_DIR=/painel
DASHBOARD=on
DASHBOARD_DIR=

# Outras origens que podem usar a API do painel (o painel em si já é servido pela API). Separe por vírgula.
CORS_ORIGIN=
